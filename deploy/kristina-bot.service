[Unit]
Description=Kristina AI Telegram Bot (agents: Persona, Advisor, Creative, TrendScout)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# AUD-03 FIX: Запуск от выделенного системного пользователя без прав root
User=kristina
Group=kristina
UMask=0077
WorkingDirectory=/opt/kristina-revolutionary
ExecStart=/opt/kristina-revolutionary/venv/bin/python bot.py
Restart=always
RestartSec=5
# Токены читаются из .env (права 0600, владелец kristina:kristina)

# Hardening systemd песочницы
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/kristina-revolutionary

# Ограничения под VPS с 1 ГБ RAM
MemoryMax=700M
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
