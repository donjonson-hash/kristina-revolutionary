KIMI_API_KEY=your-kimi-key
# Обязательные для бота и агента TrendScout:
DEEPSEEK_API_KEY=your-deepseek-key
KRISTINA_TELEGRAM_TOKEN=your-telegram-token
# Telegram chat_id админов через запятую (свой id узнать у @userinfobot);
# им приходит еженедельный отчёт TrendScout
KRISTINA_ADMIN_IDS=123456789

# GitHub read-only tool (опционально):
# Для публичных репозиториев работает без токена, но с низким rate limit.
# Если задаёшь токен, используй fine-grained token только с Contents: Read-only и Metadata: Read-only.
# GITHUB_READONLY_TOKEN=github_pat_...

# Еженедельный отчёт TrendScout (опционально):
# TREND_REPORT_DAY=0      # день недели, 0=понедельник ... 6=воскресенье
# TREND_REPORT_HOUR=8     # час запуска в UTC (8 UTC = 11:00 МСК)
# TREND_REPORT_TOPIC=     # тема исследования; пусто = общий обзор
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=your-elevenlabs-key
KRISTINA_CORS_ORIGINS=http://localhost:8000