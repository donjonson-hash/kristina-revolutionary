# ═══════════════════════════════════════════════════════════════
# KRISTINA AI - Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
# 1. Скопируйте этот файл в .env: cp .env.example .env
# 2. Заполните реальными ключами
# 3. НИКОГДА не коммитьте .env в git!
# ═══════════════════════════════════════════════════════════════

# Telegram Bot Token (получить у @BotFather)
KRISTINA_TELEGRAM_TOKEN=your_telegram_bot_token_here

# Admin IDs (через запятую, без пробелов)
KRISTINA_ADMIN_IDS=123456789

# AI API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
KIMI_API_KEY=your_kimi_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Voice API
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Image/Video Generation
KLING_ACCESS_KEY=your_kling_access_key_here
KLING_SECRET_KEY=your_kling_secret_key_here
PROXIAPI_KEY=your_proxiapi_key_here

# External APIs
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# JWT Secret (сгенерируйте случайную строку)
JWT_SECRET_KEY=your_random_jwt_secret_key_here

# Paths
KRISTINA_DATA_DIR=~/kristina_revolutionary
KRISTINA_PROJECTS_DIR=~/Projects

# CORS Origins (через запятую)
KRISTINA_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ═══════════════════════════════════════════════════════════════
# DATABASE (sqlite | postgres)
# ═══════════════════════════════════════════════════════════════
DATABASE_MODE=sqlite

# PostgreSQL (только если DATABASE_MODE=postgres)
# Вариант 1: DATABASE_URL (рекомендуется)
# DATABASE_URL=postgresql://user:password@localhost:5432/kristina_db

# Вариант 2: Отдельные параметры
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kristina_db
POSTGRES_USER=kristina_user
POSTGRES_PASSWORD=your_secure_password
