# Автоматическое нормализование окончаний строк
* text=auto eol=lf

# Бинарники — через LFS
*.apk filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text

# Vendor-бандлы не диффим
extension/*-vendor.mjs -diff -merge

# CTT ships the audited browser bundles as real Git blobs, never LFS pointers.
ctt/src/*-vendor.mjs -diff -merge
ctt/src/*font*.mjs -diff -merge
